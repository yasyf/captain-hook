{
  "events": ["PreToolUse", "PermissionRequest"],
  "tools": ["TaskStop"],
  "quoting": "[\\\\'\"\\[\\]]",
  "guarded": "\\b(kill|pkill|killall|killall5|fuser|skill|snice|kill-port|orca|launchctl|osascript|shutdown|reboot|halt|poweroff|renice|tmux|softwareupdate|pmset|caffeinate|setsid|builtin|noglob|stdbuf|unbuffer|script|watch|parallel|chrt|ionice|taskset|arch|su|chroot|find)\\b",
  "exempt_heads": ["cc-slack", "ccn", "cc-notes", "cc-present", "cc-transcript", "cat", "echo", "grep", "head", "jq", "tail", "wc"],
  "folds": {
    "İ": "i",
    "ı": "i",
    "ſ": "s",
    "K": "k"
  },
  "kinds": [
    "host-unavailable",
    "transport-error",
    "transport-timeout",
    "transport-refused",
    "shed",
    "no-verdict",
    "worker-error",
    "dependency-unavailable"
  ],
  "note": "capt-hook: the session guard did not complete ({kind}), so this call ran without its check for session-ending programs. Run `capt-hook helper status`, then `capt-hook helper install` if the host is missing or outdated.",
  "max_event_input": 33554432,
  "pass_exit": 3
}
