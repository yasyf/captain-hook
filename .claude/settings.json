          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/capt-hook run UserPromptSubmit"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/capt-hook run UserPromptSubmit --async",
            "async": true
          }
        ]
      }
    ]
  }
}
