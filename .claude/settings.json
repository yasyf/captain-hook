            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/capt-hook run Stop --async",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/capt-hook run SubagentStart"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/capt-hook run SubagentStart --async",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/capt-hook run SubagentStop"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/capt-hook run SubagentStop --async",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
