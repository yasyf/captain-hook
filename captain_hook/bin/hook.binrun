#!/usr/bin/env binrun
{
  "schema": 1,
  "name": "capt-hook",
  "kind": "python-tool",
  "version": {
    "command": ["/bin/bash", "-c", "exec \"$HOME/Applications/Captain Hook.app/Contents/Helpers/capt-hookd\" version"],
    "json_field": "build"
  },
  "tool": {
    "dist": "capt-hook",
    "entrypoint": "hook"
  }
}
