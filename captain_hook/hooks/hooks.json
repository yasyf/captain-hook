{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "c=\"$HOME/.daemonkit/bin/capt-hookd\"; [ -x \"$c\" ] || exit 0; exec \"$c\" run PreToolUse" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "c=\"$HOME/.daemonkit/bin/capt-hookd\"; [ -x \"$c\" ] || exit 0; exec \"$c\" run PostToolUse" }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          { "type": "command", "command": "c=\"$HOME/.daemonkit/bin/capt-hookd\"; [ -x \"$c\" ] || exit 0; exec \"$c\" run PostToolUseFailure" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "c=\"$HOME/.daemonkit/bin/capt-hookd\"; [ -x \"$c\" ] || exit 0; exec \"$c\" run UserPromptSubmit" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "c=\"$HOME/.daemonkit/bin/capt-hookd\"; [ -x \"$c\" ] || exit 0; exec \"$c\" run Stop" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "c=\"$HOME/.daemonkit/bin/capt-hookd\"; [ -x \"$c\" ] || exit 0; exec \"$c\" run SubagentStop" }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "c=\"$HOME/.daemonkit/bin/capt-hookd\"; [ -x \"$c\" ] || exit 0; exec \"$c\" run SubagentStart" }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "c=\"$HOME/.daemonkit/bin/capt-hookd\"; [ -x \"$c\" ] || exit 0; exec \"$c\" run PreCompact" }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "c=\"$HOME/.daemonkit/bin/capt-hookd\"; [ -x \"$c\" ] || exit 0; exec \"$c\" run Notification" }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          { "type": "command", "command": "c=\"$HOME/.daemonkit/bin/capt-hookd\"; [ -x \"$c\" ] || exit 0; exec \"$c\" run PermissionRequest" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "c=\"$HOME/.daemonkit/bin/capt-hookd\"; [ -x \"$c\" ] && exec \"$c\" run SessionStart; exec \"$HOME/Applications/Captain Hook.app/Contents/Helpers/capt-hookd\" run SessionStart --async" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "c=\"$HOME/.daemonkit/bin/capt-hookd\"; [ -x \"$c\" ] || exit 0; exec \"$c\" run SessionEnd" }
        ]
      }
    ]
  }
}
